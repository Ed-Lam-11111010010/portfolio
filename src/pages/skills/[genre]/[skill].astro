---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ProjectCard from '../../../components/ProjectCard.astro';
import { getGenres, projectsForSkill } from '../../../data/skills.js';
import { iconSvg } from '../../../lib/pixel.js';

export function getStaticPaths() {
  return getGenres().flatMap((genre) =>
    genre.skills.map((skill) => ({ params: { genre: genre.slug, skill: skill.slug }, props: { genre, skill } }))
  );
}

const { genre, skill } = Astro.props;
const base = import.meta.env.BASE_URL;
const list = projectsForSkill(skill.slug);
---

<BaseLayout title={`${skill.name} — Edwin Lam`} description={`Projects by Edwin Lam that use ${skill.name}.`}>
  <div class="container detail">
    <a href={`${base}#skills`} class="back-link"><span set:html={iconSvg('left', 12)} /> All skills</a>
    <header class="skill-header">
      <h1 class="detail-title">{skill.name}</h1>
      <p class="meta"><span class="tag">{genre.name}</span></p>
      <p class="detail-lead">{list.length === 1 ? '1 project uses' : `${list.length} projects use`} {skill.name}.</p>
    </header>
    <div class="card-grid">
      {list.map((project) => <ProjectCard project={project} level={2} />)}
    </div>
  </div>
</BaseLayout>
