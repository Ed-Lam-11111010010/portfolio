---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import ProjectRow from '../components/ProjectRow.astro';
import { getGenres, siteOrder } from '../data/skills.js';
import { horizonSvg, moonSvg, iconSvg } from '../lib/pixel.js';

const base = import.meta.env.BASE_URL;
const order = siteOrder();
const featured = order.filter((p) => p.featured);
const [lead, ...others] = featured;
const rest = order.filter((p) => !p.featured && !p.minor);
const minor = order.filter((p) => p.minor);
const building = order.find((p) => p.id === 'dino-island-rnw');
const genres = getGenres();
const tools = [
  { name: 'Python', kind: 'code' },
  { name: 'TypeScript and React', kind: 'code' },
  { name: 'Phaser.js', kind: 'games' },
  { name: 'Godot', kind: 'games' },
  { name: 'Flutter', kind: 'games' },
  { name: 'Aseprite', kind: 'art' },
  { name: 'Affinity Designer', kind: 'art' },
  { name: 'Tabletop Simulator', kind: 'art' },
];
---

<BaseLayout title="Edwin Lam — Portfolio | Lam Chi">
  <section class="hero" aria-labelledby="hero-title">
    <div class="container hero-inner">
      <span class="hero-moon" set:html={moonSvg()} />
      <h1 id="hero-title" class="hero-title">Lam Chi<span class="cursor" aria-hidden="true"></span> <span class="hero-alias">(Edwin)</span></h1>
      <p class="hero-lead">Information Engineering student at CUHK. I make games, pixel art and board games, and the tools that hold them together.</p>
      <div class="btn-row">
        <a class="btn btn--primary" href="#work">See my work</a>
        <a class="btn btn--light" href="#contact">Get in touch</a>
      </div>
      {building && (
        <a class="now" href={`${base}projects/${building.id}/`}>
          <span class="now-dot" aria-hidden="true"></span>
          <span>Now building: <span class="now-title">Dinosaur Island digital hot-seat<span class="now-arrow" set:html={iconSvg('right', 12)} /></span></span>
        </a>
      )}
    </div>
    <div class="hero-horizon" set:html={horizonSvg()} />
  </section>

  <section class="section" id="work" aria-labelledby="work-title">
    <div class="container">
      <div class="section-head">
        <h2 id="work-title" class="section-title">Featured projects</h2>
        <p class="section-intro">The four I'd show first. Each one opens its full write-up.</p>
      </div>
      {lead && <ProjectCard project={lead} variant="lead" />}
      <div class="featured-grid">
        {others.map((project) => <ProjectCard project={project} variant="featured" />)}
      </div>
    </div>
  </section>

  <section class="section section--follow" aria-labelledby="more-title">
    <div class="container">
      <h2 id="more-title" class="section-title section-title--sm">More projects</h2>
      <ul class="rows">
        {rest.map((project) => <ProjectRow project={project} />)}
      </ul>
      {minor.length > 0 && (
        <p class="aside-note">
          Smaller Python exercises:{' '}
          {minor.map((project, i) => (
            <>
              {i > 0 && (i === minor.length - 1 ? ' and ' : ', ')}
              <a href={`${base}projects/${project.id}/`}>{project.title}</a>{i === minor.length - 1 && '.'}
            </>
          ))}
        </p>
      )}
    </div>
  </section>

  <section class="band" id="about" aria-labelledby="about-title">
    <div class="container about">
      <div class="prose">
        <h2 id="about-title" class="section-title">About</h2>
        <p>
          I'm an Information Engineering student at CUHK with a multidisciplinary background spanning
          AI and game development, embedded systems, web development, game design and multimedia production.
          The work I enjoy most sits where technology and creativity meet.
        </p>
        <p>
          That has meant AI-powered browser games built with Gemini and Phaser.js, board games with
          print-ready assets, and infotainment videos. I was also a founding cabinet member of the
          CUHK Film Society 「映徒」, organising screenings and events for the university film community.
        </p>
        <p>
          Beyond the public projects here, I build private tools for my own everyday use, such as a
          Flutter app that tracks spending and recurring subscriptions in a local SQLite database, and a
          Gmail + Google Apps Script automation that files subscription receipts and compiles a monthly
          summary on its own. They stay private, but they are where I practise app design and workflow
          automation on real problems.
        </p>
      </div>
      <aside class="toolbox" aria-labelledby="tools-title">
        <h3 id="tools-title">Tools I reach for</h3>
        <ul class="tool-list">
          {tools.map((tool) => (
            <li><span class={`swatch swatch--${tool.kind}`} aria-hidden="true"></span>{tool.name}</li>
          ))}
        </ul>
        <p class="legend" aria-hidden="true">
          <span><span class="swatch swatch--code"></span>Code</span>
          <span><span class="swatch swatch--games"></span>Games and apps</span>
          <span><span class="swatch swatch--art"></span>Art and design</span>
        </p>
      </aside>
    </div>
  </section>

  <section class="section" id="skills" aria-labelledby="skills-title">
    <div class="container">
      <div class="section-head">
        <h2 id="skills-title" class="section-title">Skills</h2>
        <p class="section-intro">The number is how many projects here use each skill. Select one to see them.</p>
      </div>
      <div class="skill-groups">
        {genres.map((genre) => (
          <section class="skill-group" aria-labelledby={`area-${genre.slug}`}>
            <h3 id={`area-${genre.slug}`}>{genre.name}</h3>
            <ul class="chips">
              {genre.skills.map((skill) => (
                <li>
                  <a class="chip" href={`${base}skills/${genre.slug}/${skill.slug}/`}>
                    {skill.name}
                    <span class="count"><span class="sr-only">, used in </span>{skill.projectIds.length}<span class="sr-only"> {skill.projectIds.length === 1 ? 'project' : 'projects'}</span></span>
                  </a>
                </li>
              ))}
            </ul>
          </section>
        ))}
      </div>
    </div>
  </section>

  <section class="contact" id="contact" aria-labelledby="contact-title">
    <div class="container contact-inner">
      <div>
        <h2 id="contact-title">Let's make something</h2>
        <p>Open to internships, collaborations and game or design projects. Email is the quickest way to reach me.</p>
      </div>
      <div class="btn-row">
        <a class="btn btn--light" href="mailto:edwinlam822@gmail.com?subject=Hello%20from%20your%20portfolio">
          <span set:html={iconSvg('mail', 18)} /> Email me
        </a>
        <a class="btn btn--ghost" href="https://www.linkedin.com/in/edwinlam228/" target="_blank" rel="noopener noreferrer">LinkedIn</a>
        <a class="btn btn--ghost" href="https://github.com/Ed-Lam-11111010010" target="_blank" rel="noopener noreferrer">GitHub</a>
      </div>
    </div>
  </section>
</BaseLayout>
