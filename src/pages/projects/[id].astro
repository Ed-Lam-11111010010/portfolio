---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { findGenreForSkill, categoryLabel } from '../../data/skills.js';
import { coverSvg, iconSvg } from '../../lib/pixel.js';
import projects from '../../data/projects.json';

export function getStaticPaths() {
  return projects.map((project) => ({ params: { id: project.id }, props: { project } }));
}

const { project } = Astro.props;
const base = import.meta.env.BASE_URL;
const SOFTWARE = ['phaser.js', 'godot', 'pygame', 'gemini api', 'aseprite', 'affinity designer', 'photoshop', 'readthedocs', 'sphinx', 'tabletop simulator', 'wix', 'wordpress', 'cider'];
const skillTags = project.skills.filter((s) => !SOFTWARE.includes(s.toLowerCase()));
const softwareTags = project.skills.filter((s) => SOFTWARE.includes(s.toLowerCase()));
const links = [
  project.links.demo && { label: 'Play the demo', href: project.links.demo, primary: true },
  project.links.github && { label: 'Source on GitHub', href: project.links.github },
  project.links.video && { label: 'Watch the video', href: project.links.video },
  project.external && project.source_url && !project.links.github && { label: 'View project files', href: project.source_url },
].filter(Boolean);
const chip = (tag) => {
  const info = findGenreForSkill(tag);
  return { href: `${base}skills/${info.genreSlug}/${info.skillSlug}/`, name: info.skillName };
};
---

<BaseLayout title={`${project.title} — Edwin Lam`} description={project.description}>
  <article class="container detail">
    <a href={`${base}#projects`} class="back-link"><span set:html={iconSvg('left', 12)} /> All projects</a>

    <header class="detail-header">
      <div class="detail-cover">
        {project.image
          ? <img src={`${base}${project.image.replace(/^\//, '')}`} alt="" />
          : <Fragment set:html={coverSvg(project.id, project.category, project.title)} />}
      </div>
      <div class="detail-intro">
        <p class="project-card-meta">
          <span class="tag tag--category">{categoryLabel(project.category)}</span>
          <span>{project.year}</span>
          {project.type === 'coursework' && <span>Coursework</span>}
        </p>
        <h1 class="detail-title">{project.title}</h1>
        <p class="detail-lead">{project.description}</p>
        {links.length > 0 && (
          <div class="btn-row">
            {links.map((l) => (
              <a class:list={['btn', l.primary && 'btn--primary']} href={l.href} target="_blank" rel="noopener noreferrer">
                {l.label} <span set:html={iconSvg('out', 12)} />
              </a>
            ))}
          </div>
        )}
      </div>
    </header>

    <div class="detail-body">
      {project.highlights?.length > 0 && (
        <section>
          <h2>Highlights</h2>
          <ul class="highlights">
            {project.highlights.map((h) => <li>{h}</li>)}
          </ul>
        </section>
      )}
      <aside class="detail-aside">
        {skillTags.length > 0 && (
          <section>
            <h2>Skills</h2>
            <ul class="chip-list">{skillTags.map((t) => { const c = chip(t); return <li><a class="chip" href={c.href}>{c.name}</a></li>; })}</ul>
          </section>
        )}
        {softwareTags.length > 0 && (
          <section>
            <h2>Tools</h2>
            <ul class="chip-list">{softwareTags.map((t) => { const c = chip(t); return <li><a class="chip" href={c.href}>{c.name}</a></li>; })}</ul>
          </section>
        )}
      </aside>
    </div>
  </article>
</BaseLayout>
