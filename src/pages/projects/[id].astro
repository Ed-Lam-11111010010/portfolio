---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { findGenreForSkill, categoryLabel, neighbours } from '../../data/skills.js';
import { coverSvg, iconSvg } from '../../lib/pixel.js';
import projects from '../../data/projects.json';

export function getStaticPaths() {
  return projects.map((project) => ({ params: { id: project.id }, props: { project } }));
}

const { project } = Astro.props;
const base = import.meta.env.BASE_URL;
const { prev, next } = neighbours(project.id);
const SOFTWARE = ['phaser.js', 'godot', 'pygame', 'gemini api', 'aseprite', 'affinity designer', 'photoshop', 'readthedocs', 'sphinx', 'tabletop simulator', 'wix', 'wordpress', 'cider'];
const skillTags = project.skills.filter((s) => !SOFTWARE.includes(s.toLowerCase()));
const softwareTags = project.skills.filter((s) => SOFTWARE.includes(s.toLowerCase()));
const links = [
  project.links.demo && { label: 'Play the demo', href: project.links.demo, primary: true },
  project.links.github && { label: 'Source on GitHub', href: project.links.github },
  project.links.video && { label: 'Watch the video', href: project.links.video },
  project.external && project.source_url && !project.links.github && { label: 'View project files', href: project.source_url },
].filter(Boolean);
const chip = (tag) => {
  const info = findGenreForSkill(tag);
  return { href: `${base}skills/${info.genreSlug}/${info.skillSlug}/`, name: info.skillName };
};
---

<BaseLayout title={`${project.title} — Edwin Lam`} description={project.summary || project.description}>
  <div class="banner">
    {project.image
      ? <img src={`${base}${project.image.replace(/^\//, '')}`} alt="" />
      : <Fragment set:html={coverSvg(project, { w: 120, h: 30 })} />}
  </div>

  <article class="container detail">
    <a href={`${base}#work`} class="back-link"><span set:html={iconSvg('left', 12)} /> All projects</a>

    <div class="detail-grid">
      <div class="detail-main">
        <h1 class="detail-title">{project.title}</h1>
        <p class="meta">
          <span class="tag">{categoryLabel(project.category)}</span>
          <span>{project.year}</span>
          {project.type === 'coursework' && <span>Coursework</span>}
          {project.links.demo && <span class="tag tag--play">Playable</span>}
        </p>
        <p class="detail-lead">{project.description}</p>
        {links.length > 0 && (
          <div class="btn-row">
            {links.map((l) => (
              <a class:list={['btn', l.primary && 'btn--primary']} href={l.href} target="_blank" rel="noopener noreferrer">
                {l.label} <span set:html={iconSvg('out', 12)} />
              </a>
            ))}
          </div>
        )}

        {project.process && (
          <section aria-labelledby="process-title">
            <h2 id="process-title">{project.process.title}</h2>
            <ol class="steps">
              {project.process.steps.map((step, i) => (
                <li>
                  <span class="step-n" aria-hidden="true">{i + 1}</span>
                  <span class="step-title">{step.title}</span>
                  <span class="step-text">{step.text}</span>
                </li>
              ))}
            </ol>
          </section>
        )}

        {project.highlights?.length > 0 && (
          <section aria-labelledby="highlights-title">
            <h2 id="highlights-title">Highlights</h2>
            <ul class="highlights">
              {project.highlights.map((h) => <li>{h}</li>)}
            </ul>
          </section>
        )}
      </div>

      <aside class="detail-aside" aria-label="Project details">
        {skillTags.length > 0 && (
          <section>
            <h2>Built with</h2>
            <ul class="chips">{skillTags.map((t) => { const c = chip(t); return <li><a class="chip" href={c.href}>{c.name}</a></li>; })}</ul>
          </section>
        )}
        {softwareTags.length > 0 && (
          <section>
            <h2>Tools</h2>
            <ul class="chips">{softwareTags.map((t) => { const c = chip(t); return <li><a class="chip" href={c.href}>{c.name}</a></li>; })}</ul>
          </section>
        )}
        {project.status && (
          <section>
            <h2>Status</h2>
            <p>{project.status}</p>
          </section>
        )}
        {project.credit && (
          <section>
            <h2>About this project</h2>
            <p>{project.credit}</p>
          </section>
        )}
      </aside>
    </div>

    <nav class="pager" aria-label="More projects">
      <a class="pager-link" href={`${base}projects/${prev.id}/`}>
        <span class="pager-label"><span set:html={iconSvg('left', 12)} /> Previous project</span>
        <span class="pager-title">{prev.title}</span>
      </a>
      <a class="pager-link pager-link--next" href={`${base}projects/${next.id}/`}>
        <span class="pager-label">Next project <span set:html={iconSvg('right', 12)} /></span>
        <span class="pager-title">{next.title}</span>
      </a>
    </nav>
  </article>
</BaseLayout>
