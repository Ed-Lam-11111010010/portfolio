---
import { getGenres } from '../data/skills.js';
const genres = getGenres();
---

<div class="filter" id="projectFilter">
  <div class="filter-genres" role="group" aria-label="Skill area">
    <button class="filter-genre" type="button" data-genre="all" aria-pressed="true">All</button>
    {genres.map((g) => (
      <button class="filter-genre" type="button" data-genre={g.slug} aria-pressed="false">{g.name}</button>
    ))}
  </div>
  <div class="filter-skills" role="group" aria-label="Skills">
    {genres.map((g) => g.skills.map((s) => (
      <button class="chip filter-skill" type="button" data-skill={s.slug} data-genre={g.slug} aria-pressed="false">
        {s.name} <span class="chip-count">{s.projectIds.length}</span>
      </button>
    )))}
  </div>
  <div class="filter-status">
    <p id="filterCount" aria-live="polite"></p>
    <p class="filter-hint" id="filterHint">Pick an area to filter by skill.</p>
    <button class="text-btn" id="filterClear" type="button" hidden>Clear filters</button>
  </div>
</div>

<script>
  const root = document.getElementById('projectFilter');
  if (root) {
    const genreBtns = [...root.querySelectorAll<HTMLButtonElement>('.filter-genre')];
    const skillBtns = [...root.querySelectorAll<HTMLButtonElement>('.filter-skill')];
    const items = () => [...document.querySelectorAll<HTMLElement>('[data-project-skills]')];
    const count = document.getElementById('filterCount');
    const clear = document.getElementById('filterClear');
    const empty = document.getElementById('filterEmpty');
    let genre = 'all';
    const active = new Set<string>();

    const render = () => {
      genreBtns.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.genre === genre)));
      skillBtns.forEach((b) => {
        b.hidden = b.dataset.genre !== genre && !active.has(b.dataset.skill || '');
        b.setAttribute('aria-pressed', String(active.has(b.dataset.skill || '')));
      });
      const all = items();
      let shown = 0;
      all.forEach((el) => {
        const skills = (el.dataset.projectSkills || '').split(',');
        const match = [...active].every((s) => skills.includes(s));
        el.hidden = !match;
        if (match) shown++;
      });
      if (count) count.textContent = active.size ? `Showing ${shown} of ${all.length} projects` : `${all.length} projects`;
      if (clear) clear.hidden = active.size === 0 && genre === 'all';
      const hint = document.getElementById('filterHint');
      if (hint) hint.hidden = genre !== 'all' || active.size > 0;
      if (empty) empty.hidden = shown !== 0;
    };

    genreBtns.forEach((b) => b.addEventListener('click', () => {
      genre = b.dataset.genre === genre ? 'all' : b.dataset.genre || 'all';
      active.clear();
      render();
    }));
    skillBtns.forEach((b) => b.addEventListener('click', () => {
      const s = b.dataset.skill || '';
      active.has(s) ? active.delete(s) : active.add(s);
      render();
    }));
    clear?.addEventListener('click', () => { genre = 'all'; active.clear(); render(); });

    const params = new URLSearchParams(location.search);
    const preset = params.get('skill');
    const presetBtn = skillBtns.find((b) => b.dataset.skill === preset);
    if (presetBtn) { active.add(preset || ''); genre = presetBtn.dataset.genre || 'all'; }
    render();
  }
</script>
