---
import { findGenreForSkill, projectSkillSlugs, categoryLabel } from '../data/skills.js';
import { coverSvg } from '../lib/pixel.js';

interface Props {
  project: {
    id: string;
    title: string;
    description: string;
    year: number;
    category: string;
    skills: string[];
    image: string | null;
    links: { github: string | null; demo: string | null; video: string | null };
    highlights: string[];
    type?: string;
    featured?: number;
  };
  variant?: 'card' | 'featured';
}

const { project, variant = 'card' } = Astro.props;
const base = import.meta.env.BASE_URL;
const href = `${base}projects/${project.id}/`;
const shown = variant === 'featured' ? project.skills.slice(0, 5) : project.skills.slice(0, 3);
const more = project.skills.length - shown.length;
---

<article
  class:list={['project-card', `project-card--${variant}`]}
  data-project-skills={projectSkillSlugs(project).join(',')}
>
  <div class="project-card-cover">
    {project.image
      ? <img src={`${base}${project.image.replace(/^\//, '')}`} alt="" loading="lazy" />
      : <Fragment set:html={coverSvg(project.id, project.category, project.title)} />}
  </div>
  <div class="project-card-body">
    <p class="project-card-meta">
      <span class="tag tag--category">{categoryLabel(project.category)}</span>
      <span>{project.year}</span>
      {project.type === 'coursework' && <span>Coursework</span>}
      {project.links.demo && <span class="tag tag--demo">Playable</span>}
    </p>
    <h3 class="project-card-title">
      <a href={href} class="project-card-link">{project.title}</a>
    </h3>
    <p class="project-card-desc">{project.description}</p>
    <ul class="chip-list" aria-label="Skills">
      {shown.map((skill) => {
        const info = findGenreForSkill(skill);
        return <li><a class="chip" href={`${base}skills/${info.genreSlug}/${info.skillSlug}/`}>{info.skillName}</a></li>;
      })}
      {more > 0 && <li><span class="chip chip--muted">+{more}</span></li>}
    </ul>
  </div>
</article>
